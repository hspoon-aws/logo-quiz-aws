# Environment
NODE_ENV=development

# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB Configuration
# For local development with DynamoDB Local:
# DYNAMODB_ENDPOINT=http://localhost:8000

# Table prefix (useful for multi-environment)
DYNAMODB_TABLE_PREFIX=LogoQuiz

# Security
APP_SALT=mysalt
APP_SESSION_SECRET=mysecret

# For AWS credentials in development (not needed in production with IAM roles)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

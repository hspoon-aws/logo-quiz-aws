{
  "name": "logo-quiz-infra",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Logo Quiz",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "deploy:db": "cdk deploy LogoQuizDatabase",
    "deploy:api": "cdk deploy LogoQuizApi",
    "deploy:frontend": "cdk deploy LogoQuizFrontend",
    "deploy:websocket": "cdk deploy LogoQuizWebSocket",
    "destroy": "cdk destroy --all",
    "diff": "cdk diff"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "aws-cdk": "^2.170.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}

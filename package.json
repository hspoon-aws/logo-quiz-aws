{
  "name": "logo-quiz",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:dynamodb": "finch run -d -p 8000:8000 --name dynamodb-local amazon/dynamodb-local 2>/dev/null || finch start dynamodb-local",
    "stop:dynamodb": "finch stop dynamodb-local",
    "start:api": "tsx watch apps/api/src/main.ts",
    "start:frontend": "vite --config apps/logo-quiz/vite.config.ts",
    "build:api": "tsc -p apps/api/tsconfig.app.json && tsc-alias -p apps/api/tsconfig.app.json",
    "build:frontend": "vite build --config apps/logo-quiz/vite.config.ts",
    "build": "npm run build:api && npm run build:frontend",
    "start:api:prod": "node dist/apps/api/main.js",
    "seed": "tsx scripts/seed-dynamodb.ts",
    "seed:dynamodb": "DYNAMODB_ENDPOINT=http://localhost:8000 tsx scripts/seed-dynamodb.ts",
    "update:icons": "tsx scripts/update-aws-icons.ts",
    "update:icons:force": "tsx scripts/update-aws-icons.ts --force",
    "refresh:icons": "npm run update:icons && npm run seed:dynamodb",
    "test": "jest",
    "lint": "eslint apps libs --ext .ts,.tsx",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"libs/**/*.{ts,tsx}\""
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.540.0",
    "@aws-sdk/lib-dynamodb": "^3.540.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/websockets": "^10.3.0",
    "axios": "^1.6.0",
    "firebase": "^10.7.0",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "passport-jwt": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.21.0",
    "redux": "^5.0.0",
    "redux-thunk": "^3.1.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "uuid": "^9.0.0",
    "nest-winston": "^1.9.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/passport-http-bearer": "^1.0.41",
    "@types/passport-jwt": "^4.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "sass": "^1.69.0",
    "ts-jest": "^29.1.0",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "prettier": {
    "printWidth": 110,
    "singleQuote": true,
    "trailingComma": "all"
  }
}

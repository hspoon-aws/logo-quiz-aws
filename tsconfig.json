{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "NodeNext",
    "typeRoots": ["node_modules/@types"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@logo-quiz/models": ["libs/models/src/index.ts"],
      "@logo-quiz/environment": ["apps/logo-quiz/src/environments/environment.ts"],
      "@logo-quiz/store": ["apps/logo-quiz/src/store/index.ts"],
      "@api/environment": ["apps/api/src/environments/environment.ts"],
      "@api/config": ["apps/api/src/config.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
